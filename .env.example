# Copy to .env and fill in (never commit .env)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=urban_food_dw
HF_DATASET=allenborochin/zomato_delivery_EDA
HF_FILE=zomato_cleaned.csv
SLA_DEFAULT=40
DELAY_THRESHOLD=35
FLASK_PORT=5000
# PORT is set automatically by Render in production; local dev uses FLASK_PORT.
# PORT=10000
# Live external-data provider (optional). Default 'osm_overpass' fetches current
# restaurant listings (not delivery orders) from the keyless OpenStreetMap
# Overpass API, only when POST /api/live-fetch is called explicitly.
# 'none' keeps the project on the historical Hugging Face dataset only.
# A future authorized Zomato POS partner integration would set
# LIVE_DATA_PROVIDER to its registered adapter name plus endpoint/key below.
# Never commit real credentials.
LIVE_DATA_PROVIDER=osm_overpass
LIVE_REFRESH_SECONDS=300
# LIVE_API_BASE_URL=https://partner-api.example.com
# LIVE_API_KEY=
